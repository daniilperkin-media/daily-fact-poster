# Gemini API Key (Required for fact & prompt generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Make.com Free Webhook URL (Required for multi-platform social posting)
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_unique_webhook_id

# AWS S3 Storage (Required for hosting images publicly for social platforms)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=daily-fact-poster-bucket
