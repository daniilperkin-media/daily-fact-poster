# ==============================================================================
# OpenRouter API (Powers DeepSeek R1 Scriptwriter & Flux Visual Generator)
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
TEXT_MODEL=deepseek/deepseek-r1

# OpenRouter HTTP headers (configurable — no code change needed)
OPENROUTER_REFERER=https://github.com
OPENROUTER_TITLE=Daily Fact Poster

# ==============================================================================
# Google Gemini API Key (Primary fact generator; fallback if OpenRouter not set)
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_actual_gemini_api_key_here

# ==============================================================================
# Text-To-Speech Voice (edge-tts — Microsoft Neural TTS, free)
# Available voices:
#   en-US-ChristopherNeural   (male, deep — default)
#   en-US-AriaNeural          (female, energetic)
#   en-GB-RyanNeural          (British male)
#   en-AU-NatashaNeural       (Australian female)
#   en-US-GuyNeural           (male, authoritative)
# ==============================================================================
TTS_VOICE=en-US-ChristopherNeural

# ==============================================================================
# TikTok Developer Credentials (Direct Posting & Sandbox testing)
# ==============================================================================
TIKTOK_CLIENT_KEY=sbawrs...your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
TIKTOK_ACCESS_TOKEN=act.zv1...your_user_access_token_here
TIKTOK_PRIVACY_LEVEL=SELF_ONLY  # Change to PUBLIC_TO_EVERYONE once app is approved

# ==============================================================================
# Connected Channels (Telegram Bot, Discord Webhook, Make.com Webhook)
# ==============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxy-z
TELEGRAM_CHAT_ID=@your_channel_handle
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your_unique_webhook_id

# ==============================================================================
# AWS S3 Storage (Optional — free tmpfiles.org fallback is built-in if blank)
# Note: tmpfiles.org URLs expire after ~1 hour. Use S3 for production.
# ==============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=daily-fact-poster-bucket
